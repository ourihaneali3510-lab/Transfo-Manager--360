name: Build Android APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check project files
        run: |
          ls -la
          find . -name gradlew -type f

      - name: Build APK
        run: |
          unzip -o TRANSFO-MANAGER-360-Android-v1.zip -d project
          cd "$(dirname "$(find project -name gradlew -type f | head -n 1)")"
          chmod +x gradlew
          ./gradlew assembleDebug
